-- LÓGICA VISUAL
local function HandleVisuals(player)
    local Box = Drawing.new("Square")
    local LevelLabel = Drawing.new("Text")
    local AimLine = Drawing.new("Line")

    runService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local RootPart = player.Character.HumanoidRootPart
            local Pos, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)
            local Distance = (localPlayer.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude
            
            local isTooHigh = RootPart.Position.Y > 500 

            if OnScreen and Distance <= AimConfig.MaxDistance and not isTooHigh then
                if AimConfig.EspBoxes then
                    local SizeX = 2000 / Pos.Z
                    local SizeY = 3000 / Pos.Z
                    
                    Box.Visible = true
                    Box.Size = Vector2.new(SizeX, SizeY)
                    Box.Position = Vector2.new(Pos.X - SizeX / 2, Pos.Y - SizeY / 2)
                    Box.Color = Color3.fromRGB(255, 0, 0)
                    Box.Thickness = 1
                    Box.Filled = false

                    local lvl = 0
                    local data = player:FindFirstChild("Data") or player:FindFirstChild("leaderstats")
                    if data then
                        local lvlObj = data:FindFirstChild("Level") or data:FindFirstChild("lvl")
                        if lvlObj then lvl = lvlObj.Value end
                    end

                    LevelLabel.Visible = true
                    LevelLabel.Text = "(Level: " .. tostring(lvl) .. ")"
                    LevelLabel.Size = 16
                    LevelLabel.Center = true
                    LevelLabel.Outline = true
                    LevelLabel.Color = Color3.fromRGB(0, 0, 0)
                    LevelLabel.Position = Vector2.new(Pos.X, Pos.Y - (SizeY / 2) - 20)
                else 
                    Box.Visible = false; LevelLabel.Visible = false
                end

                if AimConfig.EspDistanceLine then
                    local SelfPos = Camera:WorldToViewportPoint(localPlayer.Character.HumanoidRootPart.Position)
                    AimLine.Visible = true
                    AimLine.From = Vector2.new(SelfPos.X, SelfPos.Y)
                    AimLine.To = Vector2.new(Pos.X, Pos.Y)
                    AimLine.Color = Color3.fromRGB(255, 0, 0)
                    AimLine.Thickness = 1
                else 
                    AimLine.Visible = false 
                end
            else 
                Box.Visible = false; LevelLabel.Visible = false; AimLine.Visible = false
            end
        else 
            Box.Visible = false; LevelLabel.Visible = false; AimLine.Visible = false 
        end
    end)
end

for _, v in pairs(players:GetPlayers()) do if v ~= localPlayer then HandleVisuals(v) end end
players.PlayerAdded:Connect(HandleVisuals)

-- LOOP AIMBOT E FOV
runService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = AimConfig.FovRadius
    
    if FOVCircle.Visible then 
        FOVCircle.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1) 
    end

    if AimConfig.Aimbot then
        local MousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local Target = nil; local Shortest = math.huge
        for _, v in pairs(players:GetPlayers()) do
            if v ~= localPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character.Humanoid.Health > 0 then
                local Pos, OnScreen = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
                local DistMag = (localPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
                
                -- SÓ MIRA SE ESTIVER DENTRO DO CÍRCULO DO FOV (RAIO)
                if OnScreen and DistMag <= AimConfig.MaxDistance then
                    local ScreenDist = (Vector2.new(Pos.X, Pos.Y) - MousePos).Magnitude
                    if ScreenDist <= AimConfig.FovRadius then
                        if DistMag < Shortest then Shortest = DistMag; Target = v end
                    end
                end
            end
        end
        if Target then
            local Pred = Target.Character.HumanoidRootPart.Position + (Target.Character.HumanoidRootPart.Velocity * AimConfig.Prediction)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Pred)
        end
    end
end)
