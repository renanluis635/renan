local function applyESP(parent, text, color, outline, size, showOutline)
    if parent:FindFirstChild("GokuVisual") then parent.GokuVisual:Destroy() end
    local billboard = Instance.new("BillboardGui", parent)
    billboard.Name = "GokuVisual"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    local label = Instance.new("TextLabel", billboard)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeColor3 = outline
    label.TextStrokeTransparency = showOutline and 0 or 1
    label.TextSize = size or 11
    label.Text = text
    label.Font = Enum.Font.GothamBold
    return label
end

